# Copy to apps/mobile/.env and fill in from Supabase → Project Settings → API.
# The publishable (anon) key is safe to ship in the app: Row Level Security protects every table.
# Never put a service-role key or an AI provider key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
